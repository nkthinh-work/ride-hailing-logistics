# ==============================================================================
# RIDE-HAILING & LOGISTICS (RHL) — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or use these defaults when launching services locally.
# Default infrastructure ports:
#   - PostgreSQL: localhost:5436
#   - Redis:      localhost:6380
#   - Kafka:      localhost:9094 (host) / rhl-kafka:9092 (docker internal)
# ==============================================================================

# Database Credentials
DB_USER=rhl
DB_PASSWORD=local

# Internal Microservice Secret (for S2S M2M authentication)
INTERNAL_SERVICE_SECRET=rhl-internal-secret-2026

# JWT Configuration
JWT_ISSUER=rhl-identity
JWT_PRIVATE_KEY_LOCATION=file:../../infra/keys/private.pem

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# Payment & Refund Gating
RHL_PAYMENT_REFUND_POLICY_GATED=true
